# Base URL of the NestJS API (docs/API.md). Server-side calls use this.
API_BASE_URL="http://localhost:3010/api/v1"
# Exposed to the browser for client-side fetches.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3010/api/v1"
# Google Identity Services client ID (not secret — it's meant to be public;
# the matching secret lives only in apps/api/.env, used server-side to
# verify tokens). Must also be added under "Authorized JavaScript origins"
# for this Client ID in Google Cloud Console for every origin this runs on.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
