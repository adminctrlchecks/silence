# ── Silence API environment ───────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
API_PORT=3010

# Database (isolated per DEPLOYMENT.md — own DB + user, localhost only)
DATABASE_URL="postgresql://silence_user:CHANGEME@localhost:5432/silence_db?schema=public"

# Redis (own logical DB index so it never collides with CtrlChecks)
REDIS_URL="redis://localhost:6379/3"

# JWT — separate secrets for admin and user tokens
JWT_ADMIN_SECRET="change-me-admin-secret"
JWT_USER_SECRET="change-me-user-secret"
JWT_ADMIN_EXPIRES_IN="12h"
JWT_USER_EXPIRES_IN="7d"

# Gemini (AI Mode answers + translation)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# CORS — the Next.js web origin(s), comma-separated
WEB_ORIGIN="http://localhost:3011"

# First admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
