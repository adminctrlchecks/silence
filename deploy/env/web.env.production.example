# Production web env (generated on the VPS by deploy/deploy.sh from deploy/.secrets.env).
# Lands at /opt/silence/apps/web/.env.production (gitignored). Reference only.
NODE_ENV=production
# Server-side calls from the Next.js app to the API (localhost, same box).
API_BASE_URL="http://127.0.0.1:3010/api/v1"
# Exposed to the browser (inlined at build time). Public HTTPS origin.
NEXT_PUBLIC_API_BASE_URL="https://silence.ctrlchecks.ai/api/v1"
