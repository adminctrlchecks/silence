# Production API env (generated on the VPS by deploy/deploy.sh from deploy/.secrets.env).
# Lands at /opt/silence/apps/api/.env (gitignored). This file is only a reference.
NODE_ENV=production
API_PORT=3010
DATABASE_URL="postgresql://silence_user:<password>@localhost:5432/silence_db?schema=public"
REDIS_URL="redis://localhost:6379/3"
JWT_ADMIN_SECRET="<generated: openssl rand -hex 32>"
JWT_USER_SECRET="<generated: openssl rand -hex 32>"
JWT_ADMIN_EXPIRES_IN="12h"
JWT_USER_EXPIRES_IN="7d"
JWT_ADMIN_REFRESH_EXPIRES_IN="30d"
JWT_USER_REFRESH_EXPIRES_IN="30d"
GEMINI_API_KEY="<your key>"
GEMINI_MODEL="gemini-2.5-flash"
# CORS: the public web origin.
WEB_ORIGIN="https://silence.ctrlchecks.ai"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="<strong password>"
