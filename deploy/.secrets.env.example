# ── Silence deployment secrets (TEMPLATE) ─────────────────────────────────────
# Copy to deploy/.secrets.env and fill in real values. The real file is
# GITIGNORED and must NEVER be committed. Phase 11 (VPS deploy) reads this file;
# if it is absent, all P11 tasks are blocked until these values are provided.
#
#   cp deploy/.secrets.env.example deploy/.secrets.env
#
# Isolation reminder (see docs/DEPLOYMENT.md): Silence runs side-by-side with
# CtrlChecks on the Hostinger VPS. Own folder /opt/silence, own DB/user, ports
# 3010/3011, own systemd units + Nginx vhost. Never reuse CtrlChecks resources.

# ── VPS / SSH access ──────────────────────────────────────────────────────────
VPS_HOST=""                 # IP or hostname of the Hostinger VPS
VPS_SSH_USER=""             # SSH user with sudo (e.g. root or a deploy user)
VPS_SSH_KEY_PATH=""         # local path to the private key, e.g. ~/.ssh/silence_deploy
VPS_SSH_PORT="22"           # SSH port (default 22)
VPS_SUDO="true"             # whether the SSH user needs sudo for systemd/nginx

# ── Deploy target on the VPS ──────────────────────────────────────────────────
DEPLOY_DIR="/opt/silence"   # isolated app directory (do NOT use /opt/ctrlchecks-*)
API_PORT="3010"             # Silence API port (isolated from CtrlChecks 3001-3007)
WEB_PORT="3011"             # Silence web port
SERVER_NAME=""              # Nginx server_name / subdomain (blank until a domain exists)

# ── PostgreSQL (localhost-only, isolated DB + user) ───────────────────────────
POSTGRES_DB="silence_db"
POSTGRES_USER="silence_user"
POSTGRES_PASSWORD=""        # strong password for silence_user (NOT the CtrlChecks DB)
DATABASE_URL=""             # postgresql://silence_user:<pwd>@localhost:5432/silence_db?schema=public

# ── Redis (own logical index) ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/3"

# ── JWT secrets (generate strong random values, e.g. openssl rand -hex 32) ─────
JWT_ADMIN_SECRET=""
JWT_USER_SECRET=""
JWT_ADMIN_EXPIRES_IN="12h"
JWT_USER_EXPIRES_IN="7d"

# ── Gemini (AI-Mode answers + translation) ────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ── First admin (seeded on deploy) ────────────────────────────────────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
